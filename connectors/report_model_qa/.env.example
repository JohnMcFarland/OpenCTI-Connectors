# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# URL of your OpenCTI instance (use http://opencti:8080 if on the same Docker
# network, or http://localhost:8080 if running standalone)
OPENCTI_URL=http://opencti:8080

# API token for the connector user in OpenCTI
# Create a dedicated user with the Connector role and paste its token here
OPENCTI_TOKEN=

# Unique UUID for this connector instance — generate with: python3 -c "import uuid; print(uuid.uuid4())"
CONNECTOR_ID=

# ── Optional — override defaults ──────────────────────────────────────────────
# CONNECTOR_LOG_LEVEL=info
# CONNECTOR_INTERVAL=120

# QA_WRITE_NOTE=true
# QA_ATTACH_JSON=false
# QA_NOTE_MAX_ROWS=50
# QA_FAIL_ON_BLOCKERS=true

# QA_KB_TTL_HOURS=24

# QA_DOC_OCR_MAX_PAGES=6
# QA_DOC_SMART_PARSE=true
# QA_DOC_SMART_PARSE_MIN_CONFIDENCE=0.70
# QA_DOC_SMART_PARSE_MAX_CANDIDATES=80

# QA_PROVENANCE_GRACE_HOURS=24
# QA_REL_DESC_FAIL_THRESHOLD=0.50

# Docker network name (only needed if not using opencti-docker_default)
# OPENCTI_NETWORK=opencti-docker_default
